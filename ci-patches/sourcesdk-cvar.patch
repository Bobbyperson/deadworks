From 3177ae470554376ef412a264db54d4b56448277b Mon Sep 17 00:00:00 2001
From: Bobbyperson <bobbyperson12345@gmail.com>
Date: Thu, 5 Nov 2026 21:20:05 -0500
Subject: [PATCH] add EConVarType_Int8 and EConVarType_UInt8 for Deadlock 6860

Deadlock 6860 inserted int8 and uint8 cvar types right after bool, so every
type from Int16 on moved up by two (tier0's type traits table now has 18
entries: bool, int8, uint8, int16, ..., vectorws). With the old enum a float32
cvar reads as a string and touching its value crashes.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 public/tier1/convar.h | 20 ++++++++++++++++++++
 1 file changed, 20 insertions(+)

diff --git a/public/tier1/convar.h b/public/tier1/convar.h
index 56ca301b..f9d7941f 100644
--- a/public/tier1/convar.h
+++ b/public/tier1/convar.h
@@ -51,6 +51,8 @@ enum EConVarType : int16_t
 {
 	EConVarType_Invalid = -1,
 	EConVarType_Bool,
+	EConVarType_Int8,
+	EConVarType_UInt8,
 	EConVarType_Int16,
 	EConVarType_UInt16,
 	EConVarType_Int32,
@@ -73,6 +75,8 @@ template<typename T>
 constexpr EConVarType TranslateConVarType();
 
 template<> constexpr EConVarType TranslateConVarType<bool>( void )		{ return EConVarType_Bool; }
+template<> constexpr EConVarType TranslateConVarType<int8>( void )		{ return EConVarType_Int8; }
+template<> constexpr EConVarType TranslateConVarType<uint8>( void )		{ return EConVarType_UInt8; }
 template<> constexpr EConVarType TranslateConVarType<int16>( void )		{ return EConVarType_Int16; }
 template<> constexpr EConVarType TranslateConVarType<uint16>( void )	{ return EConVarType_UInt16; }
 template<> constexpr EConVarType TranslateConVarType<int32>( void )		{ return EConVarType_Int32; }
@@ -100,6 +104,8 @@ union CVValue_t
 
 	CVValue_t() {}
 	CVValue_t( const bool value ) : m_bValue( value ) {}
+	CVValue_t( const int8 value ) : m_i8Value( value ) {}
+	CVValue_t( const uint8 value ) : m_u8Value( value ) {}
 	CVValue_t( const int16 value ) : m_i16Value( value ) {}
 	CVValue_t( const uint16 value ) : m_u16Value( value ) {}
 	CVValue_t( const int32 value ) : m_i32Value( value ) {}
@@ -118,6 +124,8 @@ union CVValue_t
 	~CVValue_t() {}
 
 	operator bool() const				{ return m_bValue; }
+	operator int8() const				{ return m_i8Value; }
+	operator uint8() const				{ return m_u8Value; }
 	operator int16() const				{ return m_i16Value; }
 	operator uint16() const				{ return m_u16Value; }
 	operator int32() const				{ return m_i32Value; }
@@ -136,6 +144,8 @@ union CVValue_t
 	operator const VectorWS&() const 	{ return m_vecwsValue; }
 
 	bool		m_bValue;
+	int8		m_i8Value;
+	uint8		m_u8Value;
 	int16		m_i16Value;
 	uint16		m_u16Value;
 	int32		m_i32Value;
@@ -755,6 +765,8 @@ template<> void CvarTypeTrait_ValueToStringFn<bool>( const CVValue_t *obj, CBuff
 	else
 		buf = "false";
 }
+template<> void CvarTypeTrait_ValueToStringFn<int8>( const CVValue_t *obj, CBufferString &buf ) { buf.Format( "%d", obj->m_i8Value ); }
+template<> void CvarTypeTrait_ValueToStringFn<uint8>( const CVValue_t *obj, CBufferString &buf ) { buf.Format( "%u", obj->m_u8Value ); }
 template<> void CvarTypeTrait_ValueToStringFn<int16>( const CVValue_t *obj, CBufferString &buf ) { buf.Format( "%d", obj->m_i16Value ); }
 template<> void CvarTypeTrait_ValueToStringFn<uint16>( const CVValue_t *obj, CBufferString &buf ) { buf.Format( "%u", obj->m_u16Value ); }
 template<> void CvarTypeTrait_ValueToStringFn<int32>( const CVValue_t *obj, CBufferString &buf ) { buf.Format( "%d", obj->m_i32Value ); }
@@ -858,6 +870,8 @@ static CVarTypeTraits *GetCvarTypeTraits( EConVarType type )
 
 	static CVarTypeTraits s_TypeTraits[EConVarType_MAX] = {
 		*CVarTypeTraits().InitAs<bool>( "bool", "false" ),
+		*CVarTypeTraits().InitAs<int8>( "int8", "0" ),
+		*CVarTypeTraits().InitAs<uint8>( "uint8", "0" ),
 		*CVarTypeTraits().InitAs<int16>( "int16", "0" ),
 		*CVarTypeTraits().InitAs<uint16>( "uint16", "0" ),
 		*CVarTypeTraits().InitAs<int32>( "int32", "0" ),
@@ -1052,6 +1066,8 @@ static ConVarData *GetInvalidConVarData( EConVarType type )
 
 	static ConVarData s_InvalidConVar[EConVarType_MAX + 1] = {
 		ConVarData( TranslateConVarType<bool>() ),
+		ConVarData( TranslateConVarType<int8>() ),
+		ConVarData( TranslateConVarType<uint8>() ),
 		ConVarData( TranslateConVarType<int16>() ),
 		ConVarData( TranslateConVarType<uint16>() ),
 		ConVarData( TranslateConVarType<int32>() ),
@@ -1430,6 +1446,8 @@ inline T ConVarRefAbstract::ConvertFromPrimitiveTo( CSplitScreenSlot slot ) cons
 		switch(GetType())
 		{
 			case EConVarType_Bool:      if constexpr(std::is_convertible_v<bool, T>) return value->m_bValue;
+			case EConVarType_Int8:      if constexpr(std::is_convertible_v<int8, T>) return value->m_i8Value;
+			case EConVarType_UInt8:     if constexpr(std::is_convertible_v<uint8, T>) return value->m_u8Value;
 			case EConVarType_Int16:     if constexpr(std::is_convertible_v<int16, T>) return value->m_i16Value;
 			case EConVarType_UInt16:    if constexpr(std::is_convertible_v<uint16, T>) return value->m_u16Value;
 			case EConVarType_Int32:     if constexpr(std::is_convertible_v<int32, T>) return value->m_i32Value;
@@ -1500,6 +1518,8 @@ inline void ConVarRefAbstract::ConvertToPrimitiveFrom( CSplitScreenSlot slot, co
 		switch(GetType())
 		{
 			case EConVarType_Bool:		if constexpr(std::is_convertible_v<bool, T>) return CConVarRef<bool>( *this ).Set( value, slot );
+			case EConVarType_Int8:		if constexpr(std::is_convertible_v<int8, T>) return CConVarRef<int8>( *this ).Set( value, slot );
+			case EConVarType_UInt8:		if constexpr(std::is_convertible_v<uint8, T>) return CConVarRef<uint8>( *this ).Set( value, slot );
 			case EConVarType_Int16:		if constexpr(std::is_convertible_v<int16, T>) return CConVarRef<int16>( *this ).Set( value, slot );
 			case EConVarType_UInt16:	if constexpr(std::is_convertible_v<uint16, T>) return CConVarRef<uint16>( *this ).Set( value, slot );
 			case EConVarType_Int32:		if constexpr(std::is_convertible_v<int32, T>) return CConVarRef<int32>( *this ).Set( value, slot );
-- 
